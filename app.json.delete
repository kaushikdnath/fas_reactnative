{
  "expo": {
    "name": "Ankit FAS",
    "slug": "ankit-fas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/icon.png",
    "scheme": "attendance",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/withAs608",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icons/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 220
        }
      ]
    ],
    "android": {
      "package": "com.kaushikdnath.ankitfas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icons/adaptive-foreground.png",
        "backgroundColor": "#FFFFFF",
        "imageWidth": 100
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "193bb9e1-324d-4391-b4c1-3aa353d6a24d"
      }
    },
    "owner": "kdebnath",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/193bb9e1-324d-4391-b4c1-3aa353d6a24d"
    },
    "ios": {}
  }
}
